# Shared by Contact enquiries and Careers applications.
# Local testing: mock. Real delivery: gmail.
EMAIL_MODE=mock
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=info@bvhardwares.in
CAREERS_EMAIL=info@bvhardwares.in

CAREERS_ADMIN_USERNAME=
CAREERS_ADMIN_PASSWORD=
CAREERS_SESSION_SECRET=

# Production job editing uses GitHub; local development uses data/careers.json.
GITHUB_CAREERS_REPO=
GITHUB_CAREERS_TOKEN=
GITHUB_CAREERS_BRANCH=main
GITHUB_CAREERS_PATH=data/careers.json

# Spam protection / distributed rate limiting.
# Local development can use memory. Production should use upstash.
RATE_LIMIT_MODE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a long random secret so email/IP-derived rate-limit keys are HMAC protected.
RATE_LIMIT_HASH_SECRET=

# Optional Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is configured,
# server-side verification becomes required for Contact and Careers submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Recommended in production: bvhardwares.in
TURNSTILE_EXPECTED_HOSTNAME=

# Search-engine ownership verification (optional until Search Console/Bing setup).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
